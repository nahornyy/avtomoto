        <!-- пркактика -->
        <div>
            <div class="uk-card uk-card-default uk-card-hover uk-card-small">
                <div class="uk-card-media-top">

                    {{ $image := resources.Get "images/driver.jpg" }}
                    {{ $image := $image.Crop "1000x600" }}
                    <img src="{{ $image.RelPermalink }}" width="1800" height="1000" alt="{{ .Title}}">

                </div>



                <div class="uk-card-body">
                    <h5 class="uk-card-title uk-margin-remove-bottom uk-text-default uk-text-uppercase">{{ T
                        "practic" }}</h5>
                        <p class="uk-text-meta uk-margin-remove-top">гнучкий розклад</p>
                    <p class="uk-text-meta uk-text-center">{{ T "students" }}</p>
                    <div><progress class="uk-progress" value="18" max="24"></progress></div>
                </div>
                <div class="uk-card-footer">


                    <a href="{{ .Site.LanguagePrefix }}/booking" class="uk-button uk-button-text uk-align-right">{{ T
                        "reg"}}</a>
                </div>

            </div>
        </div>
