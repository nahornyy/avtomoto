        <div>
            <div class="uk-card uk-card-default uk-card-hover uk-card-small">
                <div class="uk-card-media-top">
                    {{ with .Site.GetPage "/classes/m-chernigiv-vul-krasnosilskogo-59a" }}
                    {{ $image := .Resources.Get "main.jpg" }}
                    {{ $image := $image.Crop "1000x600" }}
                    <img src="{{ $image.RelPermalink }}" width="1800" height="1000" alt="{{ .Title}}">
                    {{ end }}
                </div>


                <div class="uk-card-body">
                    {{ $data := index .Site.Data .Site.Language.Lang }}
                    {{ range where $data.schedule "slug" "peremogy" }}
                    <div class="uk-width-expand">
                        <h5 class="uk-card-title uk-margin-remove-bottom uk-text-default uk-text-uppercase">{{
                            .street
                            }}</h5>
                        <p class="uk-text-meta uk-margin-remove-top">{{ time.Format ":date_long" .date }}</p>
                    </div>
                    <p class="uk-text-meta uk-text-center">{{ T "students" }}</p>
                    <div><progress class="uk-progress" value="{{ .student}}" max="24"></progress></div>
                </div>
                <div class="uk-card-footer">


                    <a href="{{ .url }}" class="uk-button uk-button-text uk-align-right">{{ T "detaled"}}</a>
                </div>
                {{ end }}
            </div>
        </div>

        <div>
            <div class="uk-card uk-card-default uk-card-hover uk-card-small">
