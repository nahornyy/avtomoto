<div class="uk-container uk-container-expand uk-padding-remove">
    <!--Сервисы-->
    {{ partial "serv.html" .}}

</div>

<div class="uk-container uk-container-lage">
    <!--Комментарии-->
    <h2 class="uk-h2 uk-heading-divider uk-text-center">{{ .Params.comments }}</h2>
    <div class="uk-column-1-2@s uk-column-1-3@m uk-column-1-4@l">
        <div class="remark42__last-comments" data-max="40"></div>
    </div>

    <script>
        var remark_config = {
            host: "https://remark.cynic.club",
            site_id: 'avtomoto',
            components: ['last-comments'],
            locale: 'ua',
            no_footer: true
        };
    </script>
    <script>!function (e, n) { for (var o = 0; o < e.length; o++) { var r = n.createElement("script"), c = ".js", d = n.head || n.body; "noModule" in r ? (r.type = "module", c = ".mjs") : r.async = !0, r.defer = !0, r.src = remark_config.host + "/web/" + e[o] + c, d.appendChild(r) } }(remark_config.components || ["embed"], document);</script>

</div>

{{ end }}