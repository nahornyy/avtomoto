{{ define "main" }}

{{ partial "buttons.html" . }}



<!-- Главная карусель комп-->
<div class="uk-container uk-container-expand uk-padding-remove uk-visible@m">
    <div class="uk-position-relative uk-visible-toggle uk-light uk-margin-top"
        uk-slideshow="animation: slide; autoplay: true; ratio: 192:50">

        <div class="uk-slideshow-items">

            <div>
                <img src="/banners/vs_ua.png" alt="Автошкола Чернігів. Знижка жінкам!">
            </div>
            <div>
                <img src="/banners/banner4.png" alt="Автошкола Чернігів. Знижка війсковим!">
            </div>
            <!--<div>
                <video src="/banners/video.mp4" autoplay loop muted playsinline uk-video></video>
            </div>-->
            <div>
                <iframe width="100%" height="100%"
                    src="https://www.youtube-nocookie.com/embed/Iqcp-KdJrgQ?si=PM2NPjAR1UPwc-mK&controls=0&autoplay=1&mute=1"
                    title="YouTube video player" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>


        <a class="uk-position-center-left uk-position-small uk-hidden-hover" href uk-slidenav-previous
            uk-slideshow-item="previous"></a>
        <a class="uk-position-center-right uk-position-small uk-hidden-hover" href uk-slidenav-next
            uk-slideshow-item="next"></a>

    </div>
</div>

<!-- Главная карусель моб-->
<div>
    <div class="uk-container uk-container-expand uk-padding-remove uk-hidden@m uk-margin-top">
        <div class="uk-position-relative uk-visible-toggle uk-light" uk-slideshow="min-height: 500; max-height: 500">
            <ul class="uk-slideshow-items" uk-lightbox>
                <li>
                    <img src="/banners/banner_1_ua_mob.png" alt="Автошкола Чернігів. Знижка жінкам!" uk-cover>
                </li>
                <li>
                    <img src="/banners/banner_2_ua_mob.png" alt="Автошкола Чернігів. Знижка жінкам!" uk-cover>
                </li>
            </ul>
        </div>
    </div>
</div>


<!--Интро-->
{{ partial "intro.html" .}}


<!-- Классы и даты -->
<div class="uk-container uk-container-large uk-margin-bottom">

    <div class="uk-width-1-1">
        <h3 class="uk-h3 uk-heading-divider uk-font-primary uk-text-primary uk-text-danger uk-margin uk-text-center uk-margin-top "
            uk-scrollspy="cls: uk-animation-slide-left-medium; repeat: true">{{ T "date_of_studing"}}</h3>
    </div>

    <div class="uk-margin-top uk-grid-match uk-grid-small uk-child-width-1-3@m uk-child-width-1-4@l" uk-grid
        uk-scrollspy="target: > div; cls: uk-animation-fade; delay: 300; repeat: true">
