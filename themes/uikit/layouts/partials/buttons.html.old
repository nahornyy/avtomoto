<div class="uk-container uk-container-expand ">
  <div class="uk-margin-large uk-margin-remove-bottom uk-container">
    <div class="uk-grid tm-grid-expand uk-grid-row-small uk-grid-stack" uk-grid="" >
      <div class="uk-width-1-3@m uk-first-column" >
        <div class="uk-margin uk-text-center uk-scrollspy-inview " uk-scrollspy="cls: uk-animation-slide-left; repeat: true"
          style="" bis_skin_checked="1">
          <a class="el-content uk-width-1-1 uk-button uk-button-secondary uk-flex-inline uk-flex-center uk-flex-middle"
            href="tel: +380735650500">
            <span class="uk-margin-small-right uk-icon" uk-icon="receiver"></span>
            +38 073 565 05 00
          </a>
        </div>
      </div>
      <div class="uk-width-1-3@m uk-grid-margin uk-first-column" bis_skin_checked="1">
        <div class="uk-margin uk-text-center" 
          style="" bis_skin_checked="1">
          <a class="el-content uk-width-1-1 uk-button uk-button-primary uk-flex-inline uk-flex-center uk-flex-middle"
            href="{{ .Site.LanguagePrefix }}/booking">
            <span class="uk-margin-small-right uk-icon" uk-icon="mail"></span>
            {{ T "reg_button"}}
          </a>
        </div>
         

      </div>
      <div class="uk-width-1-3@m uk-grid-margin uk-first-column" bis_skin_checked="1">
        <div class="uk-margin uk-text-center" uk-scrollspy="cls: uk-animation-slide-right; repeat: true">
          <a class="el-content uk-width-1-1 uk-button uk-button-secondary uk-flex-inline uk-flex-center uk-flex-middle"
            href="tel: +380965650500">
            <span class="uk-margin-small-right uk-icon" uk-icon="receiver"></span>
            +38 096 565 05 00
          </a>
        </div>
      </div>
    </div>
  </div>
</div>